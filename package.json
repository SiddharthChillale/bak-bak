{
  "name": "web-readaloud-extension",
  "description": "Read web articles aloud with natural Indian-English voices from Sarvam AI",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "audition": "node scripts/audition.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "~5.9.3",
    "wxt": "0.21.4"
  }
}
