{
  "name": "web-readaloud-extension",
  "description": "Listen to any web article in natural Indian-English voices (Sarvam AI), with sentence highlighting, jump-to-line and a two-host podcast mode.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/SiddharthChillale/web-readaloud-extension.git"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "package:safari": "bash scripts/package-safari.sh",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:safari": "wxt zip -b safari",
    "zip:all": "wxt zip && wxt zip -b firefox && wxt zip -b safari",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "audition": "node scripts/audition.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "happy-dom": "^20.14.6",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0"
  }
}
